OPENAI_API_KEY=replace-with-your-openai-api-key
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/rag_db
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_KEY_ID=primary
# AUTH_PREVIOUS_KEYS={"previous-2026":"replace-with-the-previous-32-byte-secret"}
AUTH_JWT_ISSUER=atlas-auth
AUTH_JWT_AUDIENCE=atlas-web
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AUTH_TRUST_PROXY=false
TDC_SIGNING_KEY=replace-with-a-separate-long-random-signing-secret
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_EMAIL_MODE=disabled
# AUTH_EMAIL_MODE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=atlas@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# Document storage and ingestion
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_SCANNER_MODE=basic
# CLAMAV_COMMAND=clamscan
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.8
