OPENAI_API_KEY=replace-with-your-openai-api-key
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/rag_db
AUTH_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Document storage and ingestion
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_SCANNER_MODE=basic
# CLAMAV_COMMAND=clamscan
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.8
